{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "release",
      "displayName": "Release",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "debug",
      "displayName": "Debug",
      "binaryDir": "${sourceDir}/build/debug",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "no-db",
      "displayName": "Release without database drivers",
      "inherits": "release",
      "binaryDir": "${sourceDir}/build/no-db",
      "cacheVariables": {
        "ANCH_SQL_MYSQL": "OFF",
        "ANCH_SQL_POSTGRESQL": "OFF"
      }
    },
    {
      "name": "asan",
      "displayName": "Debug with AddressSanitizer and UndefinedBehaviorSanitizer",
      "inherits": "debug",
      "binaryDir": "${sourceDir}/build/asan",
      "cacheVariables": {
        "ANCH_HARDENING": "OFF",
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-sanitize-recover=all -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined",
        "CMAKE_SHARED_LINKER_FLAGS": "-fsanitize=address,undefined"
      }
    },
    {
      "name": "asan-clang",
      "displayName": "Release -O2 with Clang, AddressSanitizer and UndefinedBehaviorSanitizer",
      "inherits": "asan",
      "binaryDir": "${sourceDir}/build/asan-clang",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "ANCH_OPTIMIZATION_LEVEL": "2",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++"
      }
    },
    {
      "name": "tsan",
      "displayName": "Debug with ThreadSanitizer",
      "inherits": "debug",
      "binaryDir": "${sourceDir}/build/tsan",
      "cacheVariables": {
        "ANCH_HARDENING": "OFF",
        "CMAKE_CXX_FLAGS": "-fsanitize=thread -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=thread",
        "CMAKE_SHARED_LINKER_FLAGS": "-fsanitize=thread"
      }
    },
    {
      "name": "clang",
      "displayName": "Release with Clang",
      "inherits": "release",
      "binaryDir": "${sourceDir}/build/clang",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++"
      }
    },
    {
      "name": "coverage",
      "displayName": "Debug with Clang source-based coverage (report: cmake/coverage-report.sh)",
      "inherits": "debug",
      "binaryDir": "${sourceDir}/build/coverage",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "ANCH_HARDENING": "OFF",
        "CMAKE_CXX_FLAGS": "-fprofile-instr-generate -fcoverage-mapping",
        "CMAKE_EXE_LINKER_FLAGS": "-fprofile-instr-generate",
        "CMAKE_SHARED_LINKER_FLAGS": "-fprofile-instr-generate"
      }
    },
    {
      "name": "fuzz",
      "displayName": "libFuzzer targets with AddressSanitizer and UndefinedBehaviorSanitizer (Clang)",
      "inherits": "debug",
      "binaryDir": "${sourceDir}/build/fuzz",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "ANCH_HARDENING": "OFF",
        "ANCH_BUILD_TESTS": "OFF",
        "ANCH_BUILD_FUZZ": "ON",
        "CMAKE_CXX_FLAGS": "-fsanitize=fuzzer-no-link,address,undefined -fno-sanitize-recover=all -fno-omit-frame-pointer -O1",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined",
        "CMAKE_SHARED_LINKER_FLAGS": "-fsanitize=address,undefined"
      }
    }
  ],
  "buildPresets": [
    { "name": "release", "configurePreset": "release" },
    { "name": "debug", "configurePreset": "debug" },
    { "name": "no-db", "configurePreset": "no-db" },
    { "name": "asan", "configurePreset": "asan" },
    { "name": "asan-clang", "configurePreset": "asan-clang" },
    { "name": "tsan", "configurePreset": "tsan" },
    { "name": "clang", "configurePreset": "clang" },
    { "name": "coverage", "configurePreset": "coverage" },
    { "name": "fuzz", "configurePreset": "fuzz" }
  ],
  "testPresets": [
    {
      "name": "release",
      "configurePreset": "release",
      "output": { "outputOnFailure": true },
      "execution": { "jobs": 0, "timeout": 120 }
    },
    {
      "name": "debug",
      "configurePreset": "debug",
      "output": { "outputOnFailure": true },
      "execution": { "jobs": 0, "timeout": 120 }
    },
    {
      "name": "no-db",
      "configurePreset": "no-db",
      "output": { "outputOnFailure": true },
      "execution": { "jobs": 0, "timeout": 120 }
    },
    {
      "name": "asan",
      "configurePreset": "asan",
      "output": { "outputOnFailure": true },
      "execution": { "jobs": 0, "timeout": 600 },
      "environment": {
        "ASAN_OPTIONS": "detect_leaks=1:strict_string_checks=1:detect_stack_use_after_return=1",
        "UBSAN_OPTIONS": "print_stacktrace=1:halt_on_error=1"
      }
    },
    {
      "name": "asan-clang",
      "inherits": "asan",
      "configurePreset": "asan-clang"
    },
    {
      "name": "tsan",
      "configurePreset": "tsan",
      "output": { "outputOnFailure": true },
      "execution": { "jobs": 0, "timeout": 600 },
      "environment": {
        "TSAN_OPTIONS": "halt_on_error=1:second_deadlock_stack=1:suppressions=${sourceDir}/cmake/sanitizers/tsan.supp"
      }
    },
    {
      "name": "clang",
      "configurePreset": "clang",
      "output": { "outputOnFailure": true },
      "execution": { "jobs": 0, "timeout": 120 }
    },
    {
      "name": "coverage",
      "configurePreset": "coverage",
      "output": { "outputOnFailure": true },
      "execution": { "jobs": 0, "timeout": 300 },
      "environment": {
        "LLVM_PROFILE_FILE": "${sourceDir}/build/coverage/profiles/%p-%m.profraw"
      }
    }
  ]
}
