# nginx addon configuration: ./configure --with-threads --with-compat --add-dynamic-module=<anch-rest/nginx>
ngx_addon_name=ngx_http_anch_rest_module

if test -n "$ngx_module_link"; then
    ngx_module_type=HTTP
    ngx_module_name=ngx_http_anch_rest_module
    ngx_module_incs="$ngx_addon_dir/inc"
    ngx_module_deps="$ngx_addon_dir/inc/rest/anch_rest_nginx.h"
    ngx_module_srcs="$ngx_addon_dir/ngx_http_anch_rest_module.c"
    ngx_module_libs="-ldl"

    . auto/module
else
    HTTP_MODULES="$HTTP_MODULES ngx_http_anch_rest_module"
    NGX_ADDON_SRCS="$NGX_ADDON_SRCS $ngx_addon_dir/ngx_http_anch_rest_module.c"
    CORE_INCS="$CORE_INCS $ngx_addon_dir/inc"
    CORE_LIBS="$CORE_LIBS -ldl"
fi
