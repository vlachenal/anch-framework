{
  "openapi": "3.0.3",
  "info": {
    "title": "Pet store",
    "description": "Pet store used to test anch-oas-gen",
    "version": "1.2.0"
  },
  "paths": {
    "/pets/{id}": {
      "get": {
        "operationId": "getPet",
        "parameters": [ { "name": "id", "in": "path", "required": true, "schema": { "type": "integer", "format": "int64" } } ],
        "responses": { "200": { "description": "The pet", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Pet" } } } } }
      }
    }
  },
  "components": {
    "schemas": {
      "Status": {
        "type": "string",
        "description": "Pet status in the store",
        "enum": [ "available", "pending", "sold", "in-stock", "outOfStock", "2nd-hand" ]
      },
      "Pet": {
        "type": "object",
        "description": "A pet",
        "required": [ "id", "name", "status" ],
        "properties": {
          "id": { "type": "integer", "format": "int64", "description": "Pet identifier" },
          "name": { "type": "string", "example": "Rex" },
          "uuid": { "type": "string", "format": "uuid" },
          "birth": { "type": "string", "format": "date-time" },
          "birthday": { "type": "string", "format": "date" },
          "visits": { "type": "array", "items": { "type": "string", "format": "date-time" } },
          "age": { "type": "integer", "format": "int32", "minimum": 0 },
          "weight": { "type": "number", "format": "float" },
          "price": { "type": "number" },
          "vaccinated": { "type": "boolean", "default": false },
          "status": { "$ref": "#/components/schemas/Status" },
          "previousStatus": { "$ref": "#/components/schemas/Status" },
          "size": { "type": "string", "enum": [ "small", "medium", "large", null ], "nullable": true },
          "level": { "type": "integer", "enum": [ 1, 2, 3 ] },
          "category": { "$ref": "#/components/schemas/Category" },
          "tags": { "type": "array", "items": { "$ref": "#/components/schemas/Tag" } },
          "nicknames": { "type": "array", "items": { "type": "string" } },
          "photos": { "type": "array", "items": { "type": "object", "required": [ "url" ], "properties": { "url": { "type": "string" }, "width": { "type": "integer", "format": "int32" } } } },
          "attributes": { "type": "object", "additionalProperties": { "type": "string" } },
          "scores": { "type": "object", "additionalProperties": { "type": "integer" } },
          "owner": { "type": "object", "properties": { "firstName": { "type": "string" }, "first-name": { "type": "string" } } },
          "friends": { "$ref": "#/components/schemas/Pets" },
          "comment": { "type": "string", "nullable": true },
          "class": { "type": "string" },
          "$id": { "type": "string" },
          "2fa": { "type": "boolean" },
          "Category": { "type": "string" },
          "matrix": { "type": "array", "items": { "type": "array", "items": { "type": "integer" } } },
          "anything": { },
          "extra": { "type": "object" },
          "pet": { "oneOf": [ { "$ref": "#/components/schemas/Dog" }, { "$ref": "#/components/schemas/Cat" } ] }
        }
      },
      "Category": {
        "type": "object",
        "required": [ "name" ],
        "properties": {
          "id": { "type": "integer", "format": "int64" },
          "name": { "type": "string" },
          "parent": { "$ref": "#/components/schemas/Category" },
          "children": { "type": "array", "items": { "$ref": "#/components/schemas/Category" } }
        }
      },
      "Tag": {
        "type": "object",
        "properties": { "id": { "type": "integer", "format": "int64" }, "name": { "type": "string" } }
      },
      "Pets": { "type": "array", "description": "Pets list", "items": { "$ref": "#/components/schemas/Pet" } },
      "Dog": {
        "description": "A dog",
        "allOf": [
          { "$ref": "#/components/schemas/Pet" },
          { "type": "object", "required": [ "breed" ], "properties": { "breed": { "type": "string" }, "goodBoy": { "type": "boolean" } } }
        ]
      },
      "Cat": {
        "allOf": [ { "$ref": "#/components/schemas/Pet" } ],
        "properties": { "indoor": { "type": "boolean" } }
      },
      "Owner": {
        "type": "object",
        "properties": { "name": { "type": "string" }, "house": { "$ref": "#/components/schemas/House" } }
      },
      "House": {
        "type": "object",
        "properties": { "address": { "type": "string" }, "owner": { "$ref": "#/components/schemas/Owner" }, "pets": { "type": "object", "additionalProperties": { "$ref": "#/components/schemas/Pet" } } }
      },
      "Empty": { "type": "object", "additionalProperties": false },
      "Identifier": { "type": "string", "format": "uuid" },
      "Labels": { "type": "object", "additionalProperties": { "type": "string" } },
      "Any": { "description": "Any value" },
      "Animal": { "oneOf": [ { "$ref": "#/components/schemas/Dog" }, { "$ref": "#/components/schemas/Cat" } ] }
    }
  }
}
