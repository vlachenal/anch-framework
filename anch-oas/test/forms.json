{
  "openapi": "3.0.3",
  "info": {"title": "Pet photos", "version": "1.0.0"},
  "paths": {
    "/pets/{id}/photo": {
      "post": {
        "operationId": "uploadPhoto",
        "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "integer", "format": "int64"}}],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": ["description", "photo"],
                "properties": {
                  "description": {"type": "string", "minLength": 1},
                  "age": {"type": "integer", "format": "int32"},
                  "tags": {"type": "array", "items": {"type": "string"}},
                  "photo": {"type": "string", "format": "binary"},
                  "thumbnails": {"type": "array", "items": {"type": "string", "format": "binary"}},
                  "owner": {"$ref": "#/components/schemas/Owner"},
                  "status": {"$ref": "#/components/schemas/Status"}
                }
              }
            }
          }
        },
        "responses": {
          "200": {"description": "Photo", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Photo"}}}}
        }
      }
    },
    "/pets/{id}/image": {
      "put": {
        "operationId": "uploadImage",
        "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "integer", "format": "int64"}}],
        "requestBody": {"content": {"image/png": {"schema": {"type": "string", "format": "binary"}}}},
        "responses": {
          "200": {"description": "Photo", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Photo"}}}}
        }
      }
    },
    "/owners": {
      "post": {
        "operationId": "createOwner",
        "requestBody": {
          "content": {
            "application/json": {"schema": {"$ref": "#/components/schemas/Owner"}},
            "application/x-www-form-urlencoded": {"schema": {"$ref": "#/components/schemas/Owner"}}
          }
        },
        "responses": {
          "201": {"description": "Created", "content": {"text/plain": {"schema": {"type": "string"}}}}
        }
      }
    },
    "/raw": {
      "post": {
        "operationId": "raw",
        "requestBody": {"content": {"multipart/form-data": {}}},
        "responses": {"204": {"description": "Received"}}
      }
    }
  },
  "components": {
    "schemas": {
      "Owner": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": {"type": "string", "minLength": 1, "maxLength": 10},
          "email": {"type": "string"}
        }
      },
      "Photo": {
        "type": "object",
        "properties": {
          "id": {"type": "integer", "format": "int64"},
          "description": {"type": "string"},
          "filename": {"type": "string"},
          "mediaType": {"type": "string"},
          "size": {"type": "integer", "format": "int64"},
          "thumbnails": {"type": "integer", "format": "int32"},
          "tags": {"type": "array", "items": {"type": "string"}},
          "owner": {"type": "string"}
        }
      },
      "Status": {"type": "string", "enum": ["available", "sold"]}
    }
  }
}
