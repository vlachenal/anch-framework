/*! \page page_events AnCH events library documentation
 *
 * \tableofcontents
 *
 * \section evt_intro_seq Introduction
 *
 * AnCH events library aims to provide event programming facilities (observers, event handlers and an asynchronous event bus).\n
 * It is based on C++ template. This is not a library but only header files.\n
 * \n
 * This library is based on observer/observable design pattern. So the base classes are \ref anch::events::Observer "anch::events::Observer<T>" and \ref anch::events::Observable "anch::events::Observable<T>".
 *
 * \section evt_req_sec Prerequisites
 *
 * - anch-utils header files
 * - pthread library
 *
 * \section evt_install_sec Installation
 *
 * CMake target \c anch::events (header only):
 * \code{.cmake}
find_package(Anch REQUIRED)
target_link_libraries(my-app PRIVATE anch::events)
\endcode
 * See \ref install_sec "installation".
 *
 * \section evt_concept_sec Conception
 *
 * AnCH events library is header only.\n
 * Events are \ref anch::events::Event "Event<T>": a body of type \c T and headers (string map).
 *
 * \subsection evt_concept_observ_sec Observer/Observable
 *
 * \ref anch::events::Observer "Observer<T>" implements \c handle(const Event<T>&) .
 * \ref anch::events::Observable "Observable<T>" notifies its observers synchronously with \c notifyObservers .
 * Observers can add or remove observers while being notified.
 *
 * \subsection evt_concept_handler_sec Event handler
 *
 * \ref anch::events::EventHandler "EventHandler<T, Derived>" is an observer which calls a member function of
 * \c Derived : a class can inherit several event handlers to handle several event types. It can register
 * itself in an event bus, and \c unsubscribe .
 *
 * \subsection evt_concept_eventbus_sec Event bus
 *
 * \ref anch::events::EventBus "EventBus<T>" notifies its observers asynchronously, in firing order, from a
 * dedicated thread: \c fireEvent does not wait for observers. \c EventBus<T>::getInstance() is the global bus ;
 * other buses are plain objects. A bus destructor delivers the queued events before stopping its thread.
 *
 * \section evt_example_sec Example
 *
 * \code{.cpp}
#include "events/eventBus.hpp"
#include "events/eventHandler.hpp"
#include "events/observable.hpp"
#include "events/observer.hpp"

#include <iostream>
#include <string>

// Observer: handles events of one type
class Printer: public anch::events::Observer<std::string> {
public:
  virtual void handle(const anch::events::Event<std::string>& event) noexcept override {
    std::cout << "observer: " << event.body << std::endl;
  }
};

struct Created {
  std::string name;
};

struct Deleted {
  int id;
};

// Event handlers: one class handles several event types
class Audit: public anch::events::EventHandler<Created, Audit>, public anch::events::EventHandler<Deleted, Audit> {
public:
  Audit(): anch::events::EventHandler<Created, Audit>(&Audit::onCreated),
           anch::events::EventHandler<Deleted, Audit>(&Audit::onDeleted) {
  }

  void onCreated(const anch::events::Event<Created>& event) {
    std::cout << "created: " << event.body.name << " by " << event.headers.at("user") << std::endl;
  }

  void onDeleted(const anch::events::Event<Deleted>& event) {
    std::cout << "deleted: " << event.body.id << std::endl;
  }
};

int
main() {
  // Synchronous notification
  Printer printer;
  anch::events::Observable<std::string> observable;
  observable.addObserver(printer);
  observable.notifyObservers("hello");
  observable.removeObserver(printer);

  Audit audit;
  anch::events::Observable<Created> created;
  created.addObserver(audit);
  created.notifyObservers(Created{"Rex"}, {{"user", "admin"}});

  // Asynchronous notification: events are delivered by the bus thread, in firing order
  {
    anch::events::EventBus<Deleted> bus;
    bus.addObserver(audit);
    bus.fireEvent(Deleted{1});
    bus.fireEvent(Deleted{2});
  } // bus destructor delivers queued events
  return 0;
}
\endcode
 *
 * Output:
 * \code{.txt}
observer: hello
created: Rex by admin
deleted: 1
deleted: 2
\endcode
 */
