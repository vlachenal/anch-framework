@PACKAGE_INIT@

# AnCH Framework package configuration
#
# Usage:
#   find_package(Anch REQUIRED)
#   target_link_libraries(my-target PRIVATE anch::conf anch::log)

include(CMakeFindDependencyMacro)

find_dependency(Threads)

# SQL drivers public headers include database client headers
if(@ANCH_BUILD_SQL@ AND @ANCH_SQL_MYSQL@)
  find_dependency(PkgConfig)
  pkg_search_module(MySQL REQUIRED IMPORTED_TARGET libmariadb mysqlclient)
endif()
if(@ANCH_BUILD_SQL@ AND @ANCH_SQL_POSTGRESQL@)
  find_dependency(PostgreSQL)
endif()
if(@ANCH_BUILD_SQL@ AND @ANCH_SQL_SQLITE3@)
  find_dependency(SQLite3)
endif()
# anch-rest-curl links libcurl (needed by static libraries)
if(@ANCH_BUILD_REST@ AND @ANCH_REST_CLIENT_LIB@ AND @ANCH_REST_CURL@)
  find_dependency(CURL)
endif()

# anch-rest Protobuf, gRPC and Thrift libraries public headers include these libraries headers
if(@ANCH_BUILD_REST@ AND @ANCH_REST_PROTOBUF_ENABLED@)
  find_dependency(Protobuf CONFIG)
endif()
if(@ANCH_BUILD_REST@ AND @ANCH_REST_GRPC_ENABLED@)
  find_dependency(gRPC CONFIG)
endif()
if(@ANCH_BUILD_REST@ AND @ANCH_REST_THRIFT_ENABLED@)
  find_dependency(Thrift CONFIG)
  find_dependency(Boost CONFIG)
endif()

include(${CMAKE_CURRENT_LIST_DIR}/AnchTargets.cmake)

check_required_components(Anch)
