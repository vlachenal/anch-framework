## Anch framework configuration +
# Includes and libraries directories +
set(ANCH_UTILS_INCLUDES_DIR "${PROJECT_SOURCE_DIR}/anch-utils/inc" CACHE STRING "AnCH utils include directory")

set(ANCH_UUID_INCLUDES_DIR "${PROJECT_SOURCE_DIR}/anch-uuid/inc" CACHE STRING "AnCH UUID include directory")
set(ANCH_UUID_LIBRARY_DIR "${PROJECT_SOURCE_DIR}/anch-uuid/build/lib" CACHE STRING "AnCH UUID libraries directory")

set(ANCH_CLI_INCLUDES_DIR "${PROJECT_SOURCE_DIR}/anch-cli/inc" CACHE STRING "AnCH CLI include directory")
set(ANCH_CLI_LIBRARY_DIR "${PROJECT_SOURCE_DIR}/anch-cli/build/lib" CACHE STRING "AnCH CLI libraries directory")

set(ANCH_UT_INCLUDES_DIR "${PROJECT_SOURCE_DIR}/anch-ut/inc" CACHE STRING "AnCH unit tests include directory")
set(ANCH_UT_LIBRARY_DIR "${PROJECT_SOURCE_DIR}/anch-ut/build/lib" CACHE STRING "AnCH unit tests libraries directory")

set(ANCH_INI_INCLUDES_DIR "${PROJECT_SOURCE_DIR}/anch-ini/inc" CACHE STRING "AnCH INI include directory")
set(ANCH_INI_LIBRARY_DIR "${PROJECT_SOURCE_DIR}/anch-ini/build/lib" CACHE STRING "AnCH INI libraries directory")

set(ANCH_DATE_INCLUDES_DIR "${PROJECT_SOURCE_DIR}/anch-date/inc" CACHE STRING "AnCH date include directory")
set(ANCH_DATE_LIBRARY_DIR "${PROJECT_SOURCE_DIR}/anch-date/build/lib" CACHE STRING "AnCH date libraries directory")

set(ANCH_CONF_INCLUDES_DIR "${PROJECT_SOURCE_DIR}/anch-conf/inc" CACHE STRING "AnCH conf include directory")
set(ANCH_CONF_LIBRARY_DIR "${PROJECT_SOURCE_DIR}/anch-conf/build/lib" CACHE STRING "AnCH conf include directory")

set(ANCH_CUTILS_INCLUDES_DIR "${PROJECT_SOURCE_DIR}/anch-cutils/inc" CACHE STRING "AnCH CUtils include directory")
set(ANCH_CUTILS_LIBRARY_DIR "${PROJECT_SOURCE_DIR}/anch-cutils/build/lib" CACHE STRING "AnCH CUtils libraries directory")

set(ANCH_JSON_INCLUDES_DIR "${PROJECT_SOURCE_DIR}/anch-json/inc" CACHE STRING "AnCH JSON include directory")
set(ANCH_JSON_LIBRARY_DIR "${PROJECT_SOURCE_DIR}/anch-json/build/lib" CACHE STRING "AnCH JSON libraries directory")

set(ANCH_NET_INCLUDES_DIR "${PROJECT_SOURCE_DIR}/anch-network/inc" CACHE STRING "AnCH network include directory")
set(ANCH_NET_LIBRARY_DIR "${PROJECT_SOURCE_DIR}/anch-network/build/lib" CACHE STRING "AnCH network libraries directory")

set(ANCH_DEVICE_INCLUDES_DIR "${PROJECT_SOURCE_DIR}/anch-device/inc" CACHE STRING "AnCH device include directory")

set(ANCH_EVENTS_INCLUDES_DIR "${PROJECT_SOURCE_DIR}/anch-events/inc" CACHE STRING "AnCH events include directory")
# Includes and libraries directories -

# Compilation flags +
set(ANCH_COMPILE_FLAGS "-Wall -Wextra -Werror -Wuninitialized -Wconversion -Wsign-conversion -Wformat-security -fstack-protector-all -Wstack-protector --param ssp-buffer-size=4 -ftrap  -z relro,now -fPIC -D_FORTIFY_SOURCE=2" CACHE STRING "Additional compilation flags")
#set(ANCH_COMPILE_FLAGS "-Wall -Wextra -Werror -Wuninitialized -Wconversion -Wsign-conversion -Wformat-security -fstack-protector-all -Wstack-protector --param ssp-buffer-size=4 -ftrap  -z relro,now -fPIC" CACHE STRING "Additional compilation flags")

set(ANCH_OPTIMIZATION_FLAGS "-O2 -march=native -pipe" CACHE STRING "Optimization compilation flags")
#set(ANCH_OPTIMIZATION_FLAGS "-g" CACHE STRING "Optimization compilation flags")
set(ANCH_DEBUG_FLAGS "-g" CACHE STRING "Debug compilation flags")
# Compilation flags -

# OS flags +
if(${CMAKE_SYSTEM_NAME} MATCHES "Windows")
  add_definitions("-D ANCH_WINDOWS")
else()
  add_definitions("-D ANCH_POSIX")
endif()
# OS flags -

# Build options +
# Static libraries build
set(ANCH_INI_STATIC_LIB OFF CACHE BOOL "Build static library")

# Unit tests
set(ANCH_UNIT_TESTS ON CACHE BOOL "Anch unit tests")

# UUID
set(ANCH_UUID ON CACHE BOOL "Anch UUID support")

# Harwdware options
set(ANCH_CPU_AES OFF CACHE BOOL "Activate native AES support")
set(ANCH_CPU_DETECTION ON CACHE BOOL "Activate CPU features detection")
# Build options -

# Installation options +
set(ANCH_INSTALL_INC_DIR "/usr/local/include/anch" CACHE STRING "Header installation path")
set(ANCH_INSTALL_LIB_DIR "/usr/local/lib/" CACHE STRING "Libraries installation path")
# Installation options -
## Anch framework configuration -
